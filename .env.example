# ============================================================
# FACTORY MONITOR — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit the real .env file
# ============================================================

# --- App ---
APP_ENV=development         # development | staging | production
APP_SECRET_KEY=change-me-to-a-random-256-bit-secret
APP_PORT=8000

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=factory_monitor
POSTGRES_USER=fm_user
POSTGRES_PASSWORD=change-me

# --- InfluxDB ---
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=change-me
INFLUX_ORG=factory-monitor
INFLUX_BUCKET=sensors

# --- MQTT Broker ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Dev: broker anônimo em 1883. Gateway de campo contra produção (ver docs/operations.md §MQTT):
# MQTT_BROKER_PORT=8883  MQTT_TLS=true  MQTT_CA_CERT=   (vazio = CAs do sistema)

# --- OPC UA ---
OPCUA_ENDPOINT=opc.tcp://localhost:4840

# --- AI / LLM ---
OPENAI_API_KEY=
# Assistente de IA (docs/ai_assistant.md): provedor openai | anthropic (vazio = a chave definida; ANTHROPIC preferida)
ANTHROPIC_API_KEY=
AI_PROVIDER=
AI_MODEL=
# AI_DAILY_TOKEN_BUDGET=2000000   AI_RATE_LIMIT_PER_MIN=20   AI_ENABLED=true   AI_DISABLED_TENANTS=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# --- Notifications ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alerts@factory-monitor.com
TELEGRAM_BOT_TOKEN=
WHATSAPP_API_KEY=

# --- Security ---
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Edge gateway: chave AES-256 do envelope MQTT (64 hex ou base64 de 32 bytes).
# Vazio = payload em claro. Gere com: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=

# --- CORS ---
# https://factoryconnect.tech, https://www.factoryconnect.tech e https://app.factoryconnect.tech
# são sempre permitidos pelo servidor (site público + app).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Site público: captura de leads (POST /api/public/leads) ---
# Destino da notificação de cada lead. Envio: SendGrid se SENDGRID_API_KEY estiver definido,
# senão SMTP (SMTP_HOST...). Sem configuração de e-mail o lead é gravado e o envio só é logado.
LEADS_TO_EMAIL=
LEADS_RATE_LIMIT_PER_HOUR=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true               # true = STARTTLS (porta 587) ou TLS implícito (porta 465)

# --- Uso de componentes (docs/domain.md §3.3–3.4) ---
# USAGE_DEFAULT_MAX_RATE_PER_S=10    # filtro de plausibilidade de contadores sem max_rate/ideal_cycle_time
# RUN_STATE_DEBOUNCE_S=1             # 0 mais curto que isso não gera nova partida
# MQTT_REQUIRE_ENCRYPTION=false      # true = recusa payload em claro quando ENCRYPTION_KEY está definida
# LOG_LEVEL=INFO                     # DEBUG registra 1 linha por leitura MQTT (pesado sob carga)
# SQL_ECHO=false                     # true = loga todo SQL (deixa o pipeline MQTT ~30% mais lento)
# MQTT_MAX_CONCURRENCY=12            # leituras processadas ao mesmo tempo (< pool do Postgres)
# MQTT_MAX_INFLIGHT=2000             # leituras aceitas e ainda não concluídas; acima disso o servidor para de
#                                    # confirmar (QoS 1) e o backlog fica no broker (max_queued_messages/bytes)
# MQTT_TRANSIENT_RETRY_S=600         # timeout/banco/Influx indisponível: a leitura é tentada de novo até isso
# MQTT_CLIENT_ID=                    # sessão MQTT persistente (vazio = fm-server-<POSTGRES_DB>); nunca 2 processos com o mesmo
# MQTT_PERSISTENT_SESSION=true       # clean_session=false: o broker guarda o backlog QoS 1 enquanto o servidor está fora
# INGEST_DEAD_LETTER_FILE=data/ingest_dead_letters.jsonl  # dead letters quando nem o Postgres está disponível
# PREDICTIVE_WORKER=process          # motor preditivo: process (filho do app) | external (serviço `python -m src.worker`) | inline
# USAGE_TOPOLOGY_CACHE_TTL_S=10      # cache de tags/topologia no caminho MQTT (0 = desliga)
# USAGE_RECOMPUTE_WINDOW_H=24        # recompute lê o histórico do Influx em janelas por tag
# MAX_CLOCK_SKEW_S=5                 # gateway: SourceTimestamp do CLP mais distante que isso → horário do gateway

# --- Observabilidade (make monitoring → Grafana http://localhost:3000) ---
# GRAFANA_ADMIN_PASSWORD=admin

# --- InfluxDB admin (UI em http://localhost:8086 no dev) ---
INFLUX_ADMIN_PASSWORD=adminpassword

# --- MediaMTX (câmeras RTSP → HLS) ---
# Backend rodando LOCAL (fora do Docker) com `make infra`: use localhost.
# Dentro do compose o server já recebe http://mediamtx:9997 / http://mediamtx:8888.
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_HLS_URL=http://localhost:8888

# --- Manutenção (Fase 3): Web Push, motor de manutenção e webhooks ---
# Web Push (VAPID). Sem chave privada o push fica desligado (notificações seguem no sino/e-mail).
# Gere o par com:  cd server && ../.venv/bin/python -m src.notifications.webpush
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@factoryconnect.tech
# Hosts de serviço de push aceitos como endpoint (proteção SSRF). Padrão: FCM, Mozilla, Apple, Windows.
# PUSH_ALLOWED_HOSTS=fcm.googleapis.com,android.googleapis.com,updates.push.services.mozilla.com,*.push.services.mozilla.com,*.push.apple.com,*.notify.windows.com
# Motor de manutenção (chamado emergencial, escalonamento, OS vencidas, resumo diário) e entrega de webhooks.
MAINTENANCE_TICK_S=30
MAINTENANCE_PLAN_RECOMPUTE_S=3600
# Falha (FailureRecord) sem restabelecimento há mais de N h E contradita pelos dados (parada ligada já encerrada ou
# máquina rodando de novo) → selo "falha aberta há muito tempo — verificar" no mapa/tablet/Raio-X e open_stale na
# API (kpis.md S7-23). Parada ligada ainda aberta mantém "falha". Padrão 72.
# FAILURE_STALE_OPEN_H=72
WEBHOOK_TICK_S=5
WEBHOOK_TIMEOUT_S=10
# Webhooks para endereços privados/loopback são recusados (SSRF); true só em dev/testes.
WEBHOOK_ALLOW_PRIVATE_HOSTS=false
# URL pública do app web (links em e-mails e push).
APP_PUBLIC_URL=http://localhost

# --- Sprint 6: arquivos, onboarding, relatórios e demo pública ---
# Volume de arquivos dos tenants (plantas baixas do mapa: FILES_DIR/<tenant_id>/layouts/…), nunca no banco.
# Em produção o compose fixa /app/data/files no volume server-files (sobrevive a redeploy).
# FILES_DIR=data/files
# LAYOUT_IMAGE_MAX_BYTES=10485760     # upload da planta baixa (10 MB)
# LAYOUT_IMAGE_MAX_SIDE_PX=8000
# GATEWAY_COMMAND_TTL_S=300           # comando puxado pelo gateway (browse OPC UA) expira sem resposta
# READINESS_WINDOW_MIN=15             # onboarding passo 9: tags obrigatórias com dados contínuos por N min
# Relatórios agendados (docs/reports.md §4–§5)
# REPORTS_ENABLED=true
# REPORTS_TICK_S=60
# REPORTS_ATTACHMENT_MAX_BYTES=10485760   # acima disso o e-mail leva só o link assinado (7 dias)
# REPORTS_CATCHUP_DAYS=7                  # períodos perdidos com o servidor fora são enviados até N dias depois
# Demo pública (docs/sprint6.md §5, docs/operations.md §10) — tenant somente leitura alimentado pela planta virtual
# DEMO_TENANT_SLUG=demo-publica       # nunca "demo": é o slug do tenant do seed de dev (SEED_TENANT_SLUG)
# DEMO_SESSION_HOURS=2
# DEMO_RATE_LIMIT_PER_HOUR=10         # sessões de demo por IP por hora
# DEMO_AI_QUESTIONS_PER_SESSION=10
# DEMO_PLANT_STOPPED_AFTER_S=300      # sem leitura da demo há N s → plant_running=false / faixa "parada"
# DEMO_BOT_ENABLED=true               # demo-bot: troca roteirizada do Cilindro B3 quando o alerta preditivo abre
# DEMO_BOT_TICK_S=60
# DEMO_BOT_REPLACE_AFTER_S=900        # alerta aberto há N s → o bot faz a OS e a troca
# DEMO_BOT_FAILURE_BACKOFF_S=21600    # /replace recusado ou com erro → o bot deixa a posição em paz por N s
# API de controle da planta virtual (o bot chama POST /replace). Fora do loopback ela exige X-Control-Token:
# o MESMO valor de DEMO_VIRTUAL_PLANT_CONTROL_TOKEN vai para o servidor e para o container demo-plant.
# DEMO_VIRTUAL_PLANT_CONTROL_URL=     # dev: http://localhost:7070 · prod (compose): http://demo-plant:7070
# DEMO_VIRTUAL_PLANT_CONTROL_TOKEN=   # gere com: openssl rand -hex 24

# --- Seed de dev (scripts/seed_dev.py) ---
SEED_ADMIN_PASSWORD=Admin@1234
SEED_SUPERADMIN_PASS=Super@1234

# --- Deploy manual (scripts/deploy_remote.py) — prefira o workflow Deploy do GitHub ---
# Não preencha aqui se este arquivo for compartilhado; exporte no shell.
# VPS_HOST=
# VPS_USER=deploy
# VPS_SSH_KEY=~/.ssh/factoryconnect_deploy
