# ============================================================
# FACTORY MONITOR — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit the real .env file
# ============================================================

# --- App ---
APP_ENV=development         # development | staging | production
APP_SECRET_KEY=change-me-to-a-random-256-bit-secret
APP_PORT=8000

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=factory_monitor
POSTGRES_USER=fm_user
POSTGRES_PASSWORD=change-me

# --- InfluxDB ---
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=change-me
INFLUX_ORG=factory-monitor
INFLUX_BUCKET=sensors

# --- MQTT Broker ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Dev: broker anônimo em 1883. Gateway de campo contra produção (ver docs/operations.md §MQTT):
# MQTT_BROKER_PORT=8883  MQTT_TLS=true  MQTT_CA_CERT=   (vazio = CAs do sistema)

# --- OPC UA ---
OPCUA_ENDPOINT=opc.tcp://localhost:4840

# --- AI / LLM ---
OPENAI_API_KEY=
# Assistente de IA (docs/ai_assistant.md): provedor openai | anthropic (vazio = a chave definida; ANTHROPIC preferida)
ANTHROPIC_API_KEY=
AI_PROVIDER=
AI_MODEL=
# AI_DAILY_TOKEN_BUDGET=2000000   AI_RATE_LIMIT_PER_MIN=20   AI_ENABLED=true   AI_DISABLED_TENANTS=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# --- Notifications ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alerts@factory-monitor.com
TELEGRAM_BOT_TOKEN=
WHATSAPP_API_KEY=

# --- Security ---
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Edge gateway: chave AES-256 do envelope MQTT (64 hex ou base64 de 32 bytes).
# Vazio = payload em claro. Gere com: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=

# --- CORS ---
# https://factoryconnect.tech, https://www.factoryconnect.tech e https://app.factoryconnect.tech
# são sempre permitidos pelo servidor (site público + app).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Site público: captura de leads (POST /api/public/leads) ---
# Destino da notificação de cada lead. Envio: SendGrid se SENDGRID_API_KEY estiver definido,
# senão SMTP (SMTP_HOST...). Sem configuração de e-mail o lead é gravado e o envio só é logado.
LEADS_TO_EMAIL=
LEADS_RATE_LIMIT_PER_HOUR=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true               # true = STARTTLS (porta 587) ou TLS implícito (porta 465)

# --- Uso de componentes (docs/domain.md §3.3–3.4) ---
# USAGE_DEFAULT_MAX_RATE_PER_S=10    # filtro de plausibilidade de contadores sem max_rate/ideal_cycle_time
# RUN_STATE_DEBOUNCE_S=1             # 0 mais curto que isso não gera nova partida
# MQTT_REQUIRE_ENCRYPTION=false      # true = recusa payload em claro quando ENCRYPTION_KEY está definida
# LOG_LEVEL=INFO                     # DEBUG registra 1 linha por leitura MQTT (pesado sob carga)
# SQL_ECHO=false                     # true = loga todo SQL (deixa o pipeline MQTT ~30% mais lento)
# MQTT_MAX_CONCURRENCY=12            # leituras processadas ao mesmo tempo (< pool do Postgres)
# USAGE_TOPOLOGY_CACHE_TTL_S=10      # cache de tags/topologia no caminho MQTT (0 = desliga)
# USAGE_RECOMPUTE_WINDOW_H=24        # recompute lê o histórico do Influx em janelas por tag
# MAX_CLOCK_SKEW_S=5                 # gateway: SourceTimestamp do CLP mais distante que isso → horário do gateway

# --- Observabilidade (make monitoring → Grafana http://localhost:3000) ---
# GRAFANA_ADMIN_PASSWORD=admin

# --- InfluxDB admin (UI em http://localhost:8086 no dev) ---
INFLUX_ADMIN_PASSWORD=adminpassword

# --- MediaMTX (câmeras RTSP → HLS) ---
# Backend rodando LOCAL (fora do Docker) com `make infra`: use localhost.
# Dentro do compose o server já recebe http://mediamtx:9997 / http://mediamtx:8888.
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_HLS_URL=http://localhost:8888

# --- Manutenção (Fase 3): Web Push, motor de manutenção e webhooks ---
# Web Push (VAPID). Sem chave privada o push fica desligado (notificações seguem no sino/e-mail).
# Gere o par com:  cd server && ../.venv/bin/python -m src.notifications.webpush
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@factoryconnect.tech
# Hosts de serviço de push aceitos como endpoint (proteção SSRF). Padrão: FCM, Mozilla, Apple, Windows.
# PUSH_ALLOWED_HOSTS=fcm.googleapis.com,android.googleapis.com,updates.push.services.mozilla.com,*.push.services.mozilla.com,*.push.apple.com,*.notify.windows.com
# Motor de manutenção (chamado emergencial, escalonamento, OS vencidas, resumo diário) e entrega de webhooks.
MAINTENANCE_TICK_S=30
MAINTENANCE_PLAN_RECOMPUTE_S=3600
WEBHOOK_TICK_S=5
WEBHOOK_TIMEOUT_S=10
# Webhooks para endereços privados/loopback são recusados (SSRF); true só em dev/testes.
WEBHOOK_ALLOW_PRIVATE_HOSTS=false
# URL pública do app web (links em e-mails e push).
APP_PUBLIC_URL=http://localhost

# --- Seed de dev (scripts/seed_dev.py) ---
SEED_ADMIN_PASSWORD=Admin@1234
SEED_SUPERADMIN_PASS=Super@1234

# --- Deploy manual (scripts/deploy_remote.py) — prefira o workflow Deploy do GitHub ---
# Não preencha aqui se este arquivo for compartilhado; exporte no shell.
# VPS_HOST=
# VPS_USER=deploy
# VPS_SSH_KEY=~/.ssh/factoryconnect_deploy
