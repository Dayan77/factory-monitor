# ============================================================
# FACTORY MONITOR — Production Environment
# Copie para /opt/factory-monitor/.env no VPS e preencha TODOS os valores
# ============================================================

# --- App ---
APP_ENV=production
APP_SECRET_KEY=          # gere com: openssl rand -hex 32
APP_PORT=8000

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=factory_monitor
POSTGRES_USER=fm_user
POSTGRES_PASSWORD=       # senha forte, min 20 chars

# --- InfluxDB ---
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=            # gere com: openssl rand -hex 32
INFLUX_ADMIN_PASSWORD=   # senha forte para o admin do InfluxDB UI
INFLUX_ORG=factory-monitor
INFLUX_BUCKET=sensors

# --- MQTT ---
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- AI / LLM ---
OPENAI_API_KEY=

# --- Notifications ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
TELEGRAM_BOT_TOKEN=

# --- Security ---
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=          # opcional (AES-256-GCM edge→server); gere com: openssl rand -hex 32

# --- CORS ---
CORS_ORIGINS=https://factoryconnect.tech,https://www.factoryconnect.tech

# --- Deploy ---
GITHUB_REPO=Dayan77/factory-monitor
IMAGE_TAG=latest
