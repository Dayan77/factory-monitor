{
  "version": 1,
  "description": "Linha de LED driver ueaPowerDriver (M1 hipot + M2 ATS2) lida pela API HTTP dos boxes (protocolo ueapd, edge/src/protocols/ueapd.py). tag_id preenchidos por python -m edge.src.provision --map edge/config/ueapd.example.json --out <mapa local>.",
  "gateway_id": "gw-inventus-ledd-01",
  "tenant_id": null,
  "heartbeat_s": 10,
  "pulse_poll_ms": 20,
  "sources": [
    {
      "id": "ueapd-m1",
      "protocol": "ueapd",
      "line": "hipot",
      "base_url": "${UEAPD_M1_URL:-http://192.168.1.15:8003}",
      "poll_interval_s": 2,
      "timeout_s": 5,
      "timestamps": "${UEAPD_TIMESTAMPS:-gateway}",
      "max_clock_skew_s": "${UEAPD_MAX_CLOCK_SKEW_S:-2}",
      "backfill": "none",
      "default_fault_code": 301,
      "fault_codes": {
        "ERRO_TRANSFERENCIA": 101,
        "ERRO_STOP": 102,
        "SAFETY_CONVEYOR": 103,
        "ERRO_CLAMP": 401,
        "GRAVADORA_ERRO": 501
      }
    },
    {
      "id": "ueapd-m2",
      "protocol": "ueapd",
      "line": "ats2",
      "base_url": "${UEAPD_M2_URL:-http://192.168.1.16:8003}",
