---
import Logo from "./Logo.astro";
import { FOOTER_NAV, LOGIN_URL, REGISTER_URL, CONTACT_EMAIL, TAGLINE } from "../lib/site";
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-line bg-surface">
  <div class="container-x grid gap-10 py-14 md:grid-cols-[1.4fr_repeat(3,1fr)]">
    <div>
      <Logo />
      <p class="mt-3 max-w-xs text-sm text-muted">{TAGLINE}: eficiência, manutenção e uso de cada componente, em tempo real.</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={LOGIN_URL} class="btn-ghost">Entrar</a>
        <a href={REGISTER_URL} class="btn-primary">Teste grátis</a>
      </div>
    </div>
    {FOOTER_NAV.map((col) => (
      <nav aria-label={col.title}>
        <h2 class="text-sm font-semibold text-fg">{col.title}</h2>
        <ul class="mt-3 space-y-1">
          {col.items.map((i) => (
            <li><a href={i.href} class="inline-block py-1.5 text-sm text-muted hover:text-fg">{i.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <div class="border-t border-line">
    <div class="container-x flex flex-col gap-2 py-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} FactoryConnect. Todos os direitos reservados.</p>
      <p>
        Sem rastreadores de terceiros.
        {CONTACT_EMAIL && <> · <a class="hover:text-fg" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></>}
      </p>
    </div>
  </div>
</footer>
