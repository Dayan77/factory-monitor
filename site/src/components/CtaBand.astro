---
import { REGISTER_URL } from "../lib/site";
interface Props { title?: string; text?: string }
const {
  title = "Veja a sua fábrica com outros olhos",
  text = "Conte como é a sua operação e montamos com você um piloto em uma linha — sem trocar máquinas nem CLPs.",
} = Astro.props;
---
<section class="container-x mt-24">
  <div class="reveal relative overflow-hidden rounded-3xl border border-brand-500/30 bg-surface px-6 py-12 sm:px-12">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(50%_120%_at_100%_50%,color-mix(in_oklab,var(--color-brand-500)_20%,transparent),transparent_70%)]"></div>
    <div class="relative flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold text-fg sm:text-3xl">{title}</h2>
        <p class="mt-3 text-muted">{text}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/contato" class="btn-primary">Fale conosco</a>
        <a href={REGISTER_URL} class="btn-ghost">Teste grátis</a>
      </div>
    </div>
  </div>
</section>
