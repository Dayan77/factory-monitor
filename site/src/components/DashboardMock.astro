---
// Ilustração da interface do app (não é dado real de cliente).
const bars = [62, 74, 58, 81, 77, 69, 85, 72, 79, 66, 83, 88];
---
<figure class="relative">
  <svg viewBox="0 0 640 420" class="w-full h-auto drop-shadow-2xl" role="img" aria-labelledby="dash-title">
    <title id="dash-title">Ilustração do painel FactoryConnect: OEE da linha, estado das máquinas e uso de componentes</title>
    <rect x="0.5" y="0.5" width="639" height="419" rx="16" class="fill-surface stroke-line" />
    <rect x="0.5" y="0.5" width="639" height="36" rx="16" class="fill-surface-2" />
    <rect x="0.5" y="20" width="639" height="17" class="fill-surface-2" />
    <circle cx="22" cy="18" r="5" fill="#ef4444" opacity=".8" /><circle cx="40" cy="18" r="5" fill="#f59e0b" opacity=".8" /><circle cx="58" cy="18" r="5" fill="#22c55e" opacity=".8" />
    <rect x="200" y="9" width="240" height="18" rx="9" class="fill-bg" />
    <text x="320" y="22" text-anchor="middle" class="fill-muted" font-size="10" font-family="ui-monospace,monospace">app.factoryconnect.tech</text>

    <!-- KPI tiles -->
    <g font-family="ui-sans-serif,system-ui,sans-serif">
      <rect x="20" y="52" width="140" height="74" rx="10" class="fill-bg stroke-line" />
      <text x="34" y="74" class="fill-muted" font-size="11">OEE · Linha 1</text>
      <text x="34" y="108" class="fill-fg" font-size="28" font-weight="700">78%</text>
      <rect x="180" y="52" width="140" height="74" rx="10" class="fill-bg stroke-line" />
      <text x="194" y="74" class="fill-muted" font-size="11">MTBF</text>
      <text x="194" y="108" class="fill-fg" font-size="28" font-weight="700">142 h</text>
      <rect x="340" y="52" width="140" height="74" rx="10" class="fill-bg stroke-line" />
      <text x="354" y="74" class="fill-muted" font-size="11">Peças / hora</text>
      <text x="354" y="108" class="fill-fg" font-size="28" font-weight="700">1.240</text>
      <rect x="500" y="52" width="120" height="74" rx="10" class="fill-bg stroke-line" />
      <text x="514" y="74" class="fill-muted" font-size="11">Alertas</text>
      <text x="514" y="108" fill="#f59e0b" font-size="28" font-weight="700">2</text>
    </g>

    <!-- OEE chart -->
    <rect x="20" y="142" width="380" height="258" rx="10" class="fill-bg stroke-line" />
    <text x="36" y="166" class="fill-fg" font-size="12" font-weight="600" font-family="ui-sans-serif,system-ui,sans-serif">Eficiência por hora (OEE)</text>
    {[0, 1, 2, 3].map((i) => (
      <line x1="36" x2="384" y1={200 + i * 45} y2={200 + i * 45} class="stroke-line" stroke-width="1" />
    ))}
    {bars.map((v, i) => (
      <rect x={44 + i * 28} y={380 - v * 1.9} width="16" height={v * 1.9} rx="3"
        class="bar-grow" style={`animation-delay:${i * 60}ms`}
        fill={v < 65 ? "#f59e0b" : "#25a368"} />
    ))}

    <!-- Machines -->
    <rect x="416" y="142" width="204" height="122" rx="10" class="fill-bg stroke-line" />
    <text x="432" y="166" class="fill-fg" font-size="12" font-weight="600" font-family="ui-sans-serif,system-ui,sans-serif">Máquinas</text>
    {[
      { n: "Prensa 01", c: "#22c55e", s: "Produzindo" },
      { n: "Injetora 02", c: "#22c55e", s: "Produzindo" },
      { n: "Torno CNC 03", c: "#f59e0b", s: "Parada" },
    ].map((m, i) => (
      <g font-family="ui-sans-serif,system-ui,sans-serif">
        <circle cx="440" cy={190 + i * 24} r="5" fill={m.c} class="pulse-dot" />
        <text x="454" y={194 + i * 24} class="fill-fg" font-size="11">{m.n}</text>
        <text x="604" y={194 + i * 24} text-anchor="end" class="fill-muted" font-size="10">{m.s}</text>
      </g>
    ))}

    <!-- Component usage -->
    <rect x="416" y="278" width="204" height="122" rx="10" class="fill-bg stroke-line" />
    <text x="432" y="302" class="fill-fg" font-size="12" font-weight="600" font-family="ui-sans-serif,system-ui,sans-serif">Uso de componentes</text>
    {[
      { n: "Válvula V-12 · ciclos", p: 0.86, c: "#f59e0b" },
      { n: "Rolamento M1 · horas", p: 0.52, c: "#25a368" },
      { n: "Contator K3 · partidas", p: 0.31, c: "#25a368" },
    ].map((u, i) => (
      <g font-family="ui-sans-serif,system-ui,sans-serif">
        <text x="432" y={324 + i * 26} class="fill-muted" font-size="10">{u.n}</text>
        <rect x="432" y={329 + i * 26} width="172" height="6" rx="3" class="fill-surface-2" />
        <rect x="432" y={329 + i * 26} width={172 * u.p} height="6" rx="3" fill={u.c} />
      </g>
    ))}
  </svg>
  <figcaption class="mt-3 text-center text-xs text-muted">Ilustração da interface — valores meramente demonstrativos.</figcaption>
</figure>
