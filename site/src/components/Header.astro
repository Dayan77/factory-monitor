---
import Logo from "./Logo.astro";
import DemoButton from "./DemoButton.astro";
import { NAV, LOGIN_URL, REGISTER_URL } from "../lib/site";

const current = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
const isActive = (href: string) => current === href;
---
<header class="sticky top-0 z-50 border-b border-line/70 bg-bg/85 backdrop-blur supports-[backdrop-filter]:bg-bg/70">
  <div class="container-x flex h-16 items-center justify-between gap-4 xl:max-w-7xl">
    <a href="/" class="rounded-md" aria-label="FactoryConnect — página inicial"><Logo /></a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "rounded-md px-3 py-2 text-sm font-medium transition-colors hover:text-fg",
                isActive(item.href) ? "text-fg" : "text-muted",
              ]}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <button type="button" data-theme-toggle class="grid size-11 place-items-center rounded-lg text-muted hover:bg-surface-2 hover:text-fg" aria-label="Alternar tema claro">
        <svg class="hidden dark:block" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="block dark:hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <!-- "Ver demonstração": rótulo inteiro no tablet (sem o menu principal), curto ao lado do menu em telas ≥ 1280 px;
           entre 1024 e 1279 px o menu ocupa a largura toda (a chamada fica no destaque da página e no menu móvel) -->
      <DemoButton placement="header" class="relative hidden md:inline-flex lg:hidden" statusClass="absolute right-0 top-full w-64 rounded-lg border border-line bg-surface p-3 shadow-lg" />
      <DemoButton placement="header" short class="relative hidden xl:inline-flex" statusClass="absolute right-0 top-full w-64 rounded-lg border border-line bg-surface p-3 shadow-lg" />
      <a href={LOGIN_URL} class="btn-ghost hidden sm:inline-flex">Entrar</a>
      <a href={REGISTER_URL} class="btn-primary hidden sm:inline-flex">Teste grátis</a>
      <button type="button" data-menu-toggle class="grid size-11 place-items-center rounded-lg text-fg hover:bg-surface-2 lg:hidden" aria-controls="menu-mobile" aria-expanded="false" aria-label="Abrir menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>

  <div id="menu-mobile" hidden class="border-t border-line bg-bg lg:hidden">
    <nav aria-label="Menu móvel" class="container-x py-4">
      <ul class="grid gap-1">
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}
               class="block rounded-lg px-3 py-3 text-base font-medium text-fg hover:bg-surface-2">{item.label}</a>
          </li>
        ))}
        <li><a href="/contato" class="block rounded-lg px-3 py-3 text-base font-medium text-fg hover:bg-surface-2">Contato</a></li>
      </ul>
      <DemoButton placement="menu" class="mt-4 flex w-full [&>a]:w-full" />
      <div class="mt-3 grid grid-cols-2 gap-3">
        <a href={LOGIN_URL} class="btn-ghost">Entrar</a>
        <a href={REGISTER_URL} class="btn-primary">Teste grátis</a>
      </div>
    </nav>
  </div>
</header>
