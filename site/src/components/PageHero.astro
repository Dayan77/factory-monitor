---
interface Props { eyebrow: string; title: string; lead: string }
const { eyebrow, title, lead } = Astro.props;
---
<section class="relative overflow-hidden border-b border-line">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60%_80%_at_80%_0%,color-mix(in_oklab,var(--color-brand-500)_16%,transparent),transparent_70%)]"></div>
  <div class="container-x py-16 sm:py-20">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-3 max-w-3xl text-3xl font-bold text-fg sm:text-5xl">{title}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{lead}</p>
    <slot />
  </div>
</section>
