# FactoryConnect — configuração do gateway de campo (copie para gateway.env; NUNCA commite o gateway.env).
# Docker: infra/gateway/docker-compose.yml · systemd: /etc/factoryconnect/gateway.env (edge/deploy/install.sh)

# ── Servidor e cadastro ───────────────────────────────────────────────────────
# URL do FactoryConnect (sempre https://; http:// só para localhost ou com ALLOW_INSECURE_HTTP=true em teste)
SERVER_URL=https://app.factoryconnect.tech
# Código de cadastro gerado no servidor (Gateways → gateway → "Gerar código"): XXXX-XXXX-XXXX, uso único, 24 h.
# Só na 1ª partida; depois pode apagar a linha.
ENROLL_CODE=

# ── Broker MQTT (produção: TLS na 8883) ───────────────────────────────────────
MQTT_BROKER_HOST=mqtt.factoryconnect.tech
MQTT_BROKER_PORT=8883
MQTT_TLS=true
# CA em PEM se o certificado do broker não for de uma CA pública (vazio = CAs do sistema)
MQTT_CA_CERT=
# TLS mútuo (opcional): certificado + chave do gateway em PEM
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=
# Usuário/senha MQTT: vazio = os recebidos no cadastro (usuário por gateway). Preencha só para sobrescrever.
MQTT_USERNAME=
MQTT_PASSWORD=

# ── Cifragem do payload (opcional, mesma chave AES-256 do servidor) ───────────
ENCRYPTION_KEY=

# ── Ajustes (padrões em edge/src/config.py) ────────────────────────────────────
# GATEWAY_HEARTBEAT_S=60          # heartbeat HTTP para a tela de frota (e aviso de config nova)
# GATEWAY_CONFIG_POLL_S=300       # busca de configuração por garantia (ETag; 304 quando nada mudou)
# DEADBAND_PCT=0.5
# DEADBAND_MAX_SILENCE_S=30
# Variáveis usadas nos endereços do mapa vindo do servidor, ex. opc.tcp://${PLC_HOST:-10.0.0.10}:4840/
# PLC_HOST=10.0.0.10
# Plano B sem servidor na 1ª partida: mapa local (montado no container)
# PLANT_MAP_PATH=/data/plant.local.json
