# ============================================================
# FACTORYCONNECT — STAGING (pré-produção no mesmo VPS)
# Copie para /opt/factory-monitor-staging/.env e preencha. TODOS os segredos DIFERENTES da produção
# (um vazamento do staging não pode abrir a produção). docs/go_live.md §3, infra/docker-compose.staging.yml.
# ============================================================

# --- App --- (APP_ENV=production: staging se comporta como produção — HSTS, cookies, validações)
APP_ENV=production
APP_SECRET_KEY=          # openssl rand -hex 32 (≠ produção)
APP_PORT=8000
STAGING_HOST=staging.factoryconnect.tech
CORS_ORIGINS=https://staging.factoryconnect.tech

# --- PostgreSQL (container fm_stg_postgres, volume fm-staging_postgres-data) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=factory_monitor_staging
POSTGRES_USER=fm_staging
POSTGRES_PASSWORD=change-me-staging

# --- InfluxDB (container fm_stg_influxdb) ---
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=change-me-staging-token
INFLUX_ADMIN_PASSWORD=change-me-staging-admin
INFLUX_ORG=factory-monitor
INFLUX_BUCKET=sensors
# STAGING_INFLUX_RETENTION=30d

# --- MQTT (broker próprio, só loopback 127.0.0.1:11883) ---
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=fm-backend
MQTT_PASSWORD=change-me-staging-mqtt-0123456789
MQTT_ALLOW_NO_GATEWAYS=1
# MQTT_GATEWAYS_DIR=/opt/factory-monitor-staging/mqtt
# STAGING_MQTT_PORT=11883

# --- Imagens (as MESMAS da produção: a versão validada aqui vai para a produção sem rebuild) ---
FM_IMAGE_PREFIX=ghcr.io/dayan77/factoryconnect

# --- Notificações: deixe vazio (staging não manda e-mail para clientes) ou use uma caixa de teste ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SMTP_HOST=
LEADS_TO_EMAIL=

# --- IA: vazio = assistente desligado em staging (ou chave com orçamento baixo) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Segurança ---
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=
